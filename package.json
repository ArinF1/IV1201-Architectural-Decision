{
    "name": "iv1201-recruitment-app",
    "version": "1.0.0",
    "description": "KTH IV1201 Recruitment Application",
    "scripts": {
        "start": "node backend/src/server.js",
        "install:backend": "cd backend && npm install --include=dev",
        "install:frontend": "cd frontend && npm install --include=dev",
        "build:frontend": "cd frontend && npm run build",
        "heroku-postbuild": "npm run install:backend && npm run install:frontend && npm run build:frontend"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "selenium-webdriver": "^4.41.0",
        "supertest": "^7.2.2"
    }
}
